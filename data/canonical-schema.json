{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sub-population Fairness & Readiness Auditor canonical participant record",
  "type": "object",
  "required": [
    "participant_id",
    "diagnosis_date",
    "index_date",
    "index_definition",
    "prediction_horizon_months",
    "age_at_diagnosis",
    "age_group",
    "sex",
    "race_ethnicity",
    "cancer_type",
    "risk_group",
    "site",
    "predicted_risk_2y",
    "outcome_2y",
    "outcome_date",
    "last_contact_date",
    "event_observed",
    "lost_to_followup",
    "censoring_reason"
  ],
  "properties": {
    "participant_id": {"type": "string"},
    "diagnosis_date": {"type": "string", "format": "date"},
    "index_date": {"type": "string", "format": "date"},
    "index_definition": {"const": "Day 180 after diagnosis"},
    "prediction_horizon_months": {"const": 24},
    "age_at_diagnosis": {"type": "number", "minimum": 0, "maximum": 39},
    "age_group": {"type": "string"},
    "sex": {"type": ["string", "null"]},
    "race_ethnicity": {"type": ["string", "null"]},
    "cancer_type": {"type": "string"},
    "risk_group": {"enum": ["Standard", "Intermediate", "High"]},
    "site": {"type": "string"},
    "diagnosis_classification_system": {"type": ["string", "null"]},
    "disease_stage": {"type": ["string", "null"]},
    "tumor_histology": {"type": ["string", "null"]},
    "image_defined_risk_factor": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "mycn_amplified": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "tumor_ploidy": {"type": ["string", "null"]},
    "segmental_chromosomal_aberration": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "wilms_loh_1p_16q": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "wilms_1q_gain": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "years_since_diagnosis": {"type": ["integer", "null"], "minimum": 0},
    "care_model": {"type": ["string", "null"]},
    "primary_language": {"type": ["string", "null"]},
    "cost_barrier": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "transition_readiness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "anthracycline_dose_band": {"type": ["string", "null"]},
    "alkylating_agent_dose_band": {"type": ["string", "null"]},
    "chest_radiation": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "cranial_neck_radiation": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "abdominal_pelvic_radiation": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "hematopoietic_stem_cell_transplant": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "molecular_test_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "molecular_test_completed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "treatment_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "treatment_received": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "treatment_adherent": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "followup_complete": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "psychosocial_screen_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "psychosocial_screen_completed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "survivorship_plan_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "survivorship_plan_completed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "fertility_risk_assessment_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "fertility_risk_assessed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "fertility_preservation_eligible": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "fertility_preservation_discussed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "fertility_preservation_completed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "recommendations_given": {"type": ["integer", "null"], "minimum": 0},
    "recommendations_recalled": {"type": ["integer", "null"], "minimum": 0},
    "recommendations_completed": {"type": ["integer", "null"], "minimum": 0},
    "adverse_event": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "predicted_risk_2y": {"type": "number", "minimum": 0, "maximum": 1},
    "outcome_2y": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "latent_outcome_2y": {"type": "integer", "minimum": 0, "maximum": 1},
    "time_to_event_months": {"type": "number", "minimum": 0, "maximum": 24},
    "event_observed": {"type": "integer", "minimum": 0, "maximum": 1},
    "lost_to_followup": {"type": "integer", "minimum": 0, "maximum": 1},
    "outcome_date": {"type": ["string", "null"], "format": "date"},
    "last_contact_date": {"type": "string", "format": "date"},
    "censoring_reason": {"enum": ["Outcome observed", "Loss to follow-up", "Administrative end of 24-month horizon"]}
  }
}
